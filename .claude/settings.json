{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.envrc)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/.envrc)",
      "Read(./.npmrc)",
      "Read(./.netrc)",
      "Read(./.pypirc)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ed25519*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*credentials*)",
      "Read(./**/*secret*)",
      "Read(./**/kubeconfig*)",
      "Read(./**/config.json)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "devforge",
      "devforge *"
    ],
    "filesystem": {
      "denyRead": [
        "./.env",
        "./.env.*",
        "./.envrc",
        "./**/.env",
        "./**/.env.*",
        "./**/.envrc",
        "./.npmrc",
        "./.netrc",
        "./.pypirc",
        "./**/id_rsa*",
        "./**/id_ed25519*",
        "./**/*.pem",
        "./**/*.key",
        "./**/*credentials*",
        "./**/*secret*",
        "./**/kubeconfig*"
      ]
    },
    "credentials": {
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "JIRA_API_TOKEN",
          "mode": "deny"
        },
        {
          "name": "JIRA_USER_EMAIL",
          "mode": "deny"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        },
        {
          "name": "OPENAI_API_KEY",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITLAB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "CLOUDFLARE_API_TOKEN",
          "mode": "deny"
        },
        {
          "name": "DOCKER_PASSWORD",
          "mode": "deny"
        },
        {
          "name": "AWS_ACCESS_KEY_ID",
          "mode": "deny"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "mode": "deny"
        },
        {
          "name": "AZURE_CLIENT_SECRET",
          "mode": "deny"
        },
        {
          "name": "GOOGLE_APPLICATION_CREDENTIALS",
          "mode": "deny"
        }
      ],
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh",
          "mode": "deny"
        },
        {
          "path": "~/.config/gcloud",
          "mode": "deny"
        },
        {
          "path": "~/.kube",
          "mode": "deny"
        },
        {
          "path": "~/.docker",
          "mode": "deny"
        },
        {
          "path": "~/.azure",
          "mode": "deny"
        },
        {
          "path": "~/.config/opencode",
          "mode": "deny"
        },
        {
          "path": "~/.codex",
          "mode": "deny"
        }
      ]
    }
  }
}
